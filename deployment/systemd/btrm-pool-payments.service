[Unit]
Description=Bitoreum pool: payment processor (sendmany from the pool wallet; emergency brake: deployment/pause-payments.sh)
After=btrm-pool-redis.service btrm-node.service
Requires=btrm-pool-redis.service
[Service]
Type=simple
User=btrmpool
WorkingDirectory=/opt/btrm-nodejs-pool
ExecStart=/usr/bin/node /opt/btrm-nodejs-pool/init.js -module=payments
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
